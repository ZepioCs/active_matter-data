{"schemaVersion": 1, "_note": "Layout of the compare page. Sections render in order; each field is either a weapon stat key (e.g. \"Fire rate\") or a derived metric starting with @ (see KNOWN_METRICS in src/domain.ts). Damage metrics come from the game-files model (hitPowerMult x falloff x dmgMult 10, docs/damage-calculation.md). better: highlight the highest (\"high\") or lowest (\"low\") value. Unknown values are never ranked.", "targetHp": 100, "sections": [{"id": "firepower", "title": "Firepower", "subtitle": "Output math from fire rate, magazine and game-files ammunition damage (10 m reference).", "fields": [{"key": "@damage", "label": "Damage / shot @10 m", "digits": 0, "better": "high"}, {"key": "Fire rate", "label": "Fire rate (RPM)", "digits": 0, "better": "high", "bar": true}, {"key": "@dps", "label": "DPS @10 m", "digits": 1, "better": "high", "bar": true}, {"key": "Magazine", "digits": 0, "better": "high"}, {"key": "@shotsToKill", "label": "Shots to kill", "digits": 0, "better": "low"}, {"key": "@ttk", "label": "Time to kill (s)", "digits": 3, "better": "low"}, {"key": "@killsPerMag", "label": "Kills per magazine", "digits": 0, "better": "high"}, {"key": "@magDump", "label": "Mag dump (s)", "better": "low"}, {"key": "@sustainedRpm", "label": "Sustained RPM", "digits": 1, "better": "high"}, {"key": "@rounds5", "label": "Rounds / 5 s", "digits": 0, "better": "high"}, {"key": "@rounds10", "label": "Rounds / 10 s", "digits": 0, "better": "high"}, {"key": "Reload (s)", "better": "low"}]}, {"id": "damage-model", "title": "Damage model (game files)", "subtitle": "Falloff per trigger pull (all pellets) and kill math vs head 100 HP / body 220 HP, unarmored. Armor and range scenarios below adjust these numbers.", "fields": [{"key": "@dmg50", "label": "Damage @50 m", "digits": 0, "better": "high"}, {"key": "@dmg100", "label": "Damage @100 m", "digits": 0, "better": "high"}, {"key": "@dmg200", "label": "Damage @200 m", "digits": 0, "better": "high"}, {"key": "@shotsHead", "label": "Shots to kill head", "digits": 0, "better": "low"}, {"key": "@shotsBody", "label": "Shots to kill torso", "digits": 0, "better": "low"}, {"key": "@ttkBody", "label": "TTK torso (s)", "digits": 3, "better": "low"}]}, {"id": "handling", "title": "Handling", "subtitle": "Lower is better on every row.", "fields": [{"key": "Recoil", "better": "low"}, {"key": "Deviation", "better": "low"}, {"key": "Aiming (s)", "better": "low"}, {"key": "Accuracy (MOA)", "better": "low"}, {"key": "Weight", "better": "low"}, {"key": "Volume", "better": "low"}]}, {"id": "protection", "title": "Protection", "subtitle": "Wearable armor from the game files. Values are the fraction of damage stopped per channel.", "fields": [{"key": "Durability", "digits": 0, "better": "high"}, {"key": "Protection (projectile)", "digits": 2, "better": "high"}, {"key": "Protection (melee)", "digits": 2, "better": "high"}, {"key": "Protection (explosion)", "digits": 2, "better": "high"}]}, {"id": "cost", "title": "Cost & logistics", "subtitle": "Shop prices and ammunition economy.", "fields": [{"key": "Shop price (credits)", "digits": 0, "better": "low", "thousands": true}, {"key": "Shop access"}, {"key": "@modsPrice", "label": "Mods total", "digits": 0, "better": "low", "thousands": true}, {"key": "@costRound", "label": "Cost / round", "better": "low"}, {"key": "@costMag", "label": "Cost / magazine", "digits": 1, "better": "low"}, {"key": "@cost10", "label": "10 magazines", "digits": 0, "better": "low"}, {"key": "@startup", "label": "Startup: gun + 5 mags", "digits": 0, "better": "low"}]}]}
